{
  "name": "@laioutr/app-klaviyo",
  "version": "1.3.0",
  "description": "Integrate Klaviyo into your Laioutr project",
  "repository": "laioutr/app-klaviyo",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "laioutr.manifest.json"
  ],
  "scripts": {
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "orchestr-dev": "npm run orchestr-dev:prepare && nuxi dev orchestr-playground",
    "orchestr-dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare orchestr-playground",
    "prepack": "nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "release:cockpit": "LAIOUTR_API_KEY=\"$LAIOUTR_APP_PUBLISH_KEY\" laioutr app release",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "defu": "6.1.4"
  },
  "peerDependencies": {
    "@laioutr-core/canonical-types": ">=0.39.10",
    "@laioutr-core/core-types": ">=0.78.0",
    "@laioutr-core/frontend-core": ">=0.78.0",
    "@laioutr-core/kit": ">=0.78.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@laioutr-app/ui": "2.34.1",
    "@laioutr-core/canonical-types": "0.39.10",
    "@laioutr-core/core-types": "^0.78.0",
    "@laioutr-core/devtools": "^0.78.0",
    "@laioutr-core/frontend-core": "^0.78.0",
    "@laioutr-core/kit": "^0.78.0",
    "@laioutr/cli": "^0.6.0",
    "@laioutr/eslint-config": "^1.5.0",
    "@laioutr/logger": "^0.5.1",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/devtools-ui-kit": "2.5.0",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "3.19.1",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@types/node": "latest",
    "@vueuse/core": "13.1.0",
    "eslint": "^9.35.0",
    "nuxt": "3.16.2",
    "pinia": "3.0.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10",
    "zod": "3.25.61"
  }
}
